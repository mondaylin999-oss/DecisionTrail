{
  "name": "decisiontrail",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed-cases": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-cases.ts",
    "db:seed-demo": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/seed-demo.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "geist": "^1.9.2",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
