# ── Firebase web app (Firebase console → Project settings → Your apps) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── App Check (Google Cloud console → Security → reCAPTCHA; Website key, score-based) ──
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional: a fixed debug token for localhost (register it in App Check → Manage debug tokens).
# Leave empty to have the SDK print a new one in the browser console.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# ── Gemini models used for cloud inference (pin them; models get retired) ──
NEXT_PUBLIC_GEMINI_CLOUD_MODEL=gemini-3.5-flash-lite
NEXT_PUBLIC_GEMINI_RESEARCH_MODEL=gemini-3.5-flash-lite

# ── Server only: Firebase Admin token verification ──
FIREBASE_PROJECT_ID=your-project

# Also verify App Check tokens on our own /api routes (recommended in production).
APP_CHECK_ENFORCE_API=false

# ── PostgreSQL (Neon, Supabase, Cloud SQL or local) ──
DATABASE_URL=postgres://user:password@localhost:5432/decisiontrail

# ── Split deployment (leave blank for a single-origin local deployment) ──
NEXT_PUBLIC_API_BASE_URL=
FRONTEND_ORIGIN=
